  langid    = {english},
  file      = {/home/lukas/Zotero/storage/C2XVBEZ3/McArdle and McDonald - 1984 - Some algebraic properties of the Reticular Action Model for moment structures.pdf;/home/lukas/Zotero/storage/MFJT7AVB/j.2044-8317.1984.tb00802.html}
}
